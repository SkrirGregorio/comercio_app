{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-empresas",
      "urls": [
        "http://136.111.42.49:3000/empresas**",
        "http://136.111.42.49:3000/upload/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "2h",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-posts-servicios",
      "urls": [
        "http://136.111.42.49:3000/posts**",
        "http://136.111.42.49:3000/servicios**",
        "http://136.111.42.49:3000/resenas**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "30m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-auth",
      "urls": [
        "http://136.111.42.49:3000/auth/**"
      ],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "5m",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "google-maps",
      "urls": [
        "https://maps.googleapis.com/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "1d",
        "timeout": "10s",
        "strategy": "performance"
      }
    }
  ]
}
